{
  "name": "keylocal",
  "productName": "Keylocal",
  "version": "0.4.0",
  "description": "An offline KeePass-compatible personal vault",
  "author": "Keylocal contributors",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack:win": "npm run build && electron-builder --win nsis --x64",
    "pack:mac": "npm run build && electron-builder --mac dmg --arm64 --x64",
    "test:ui": "node tests/ui-smoke.cjs",
    "format": "prettier --write src electron tests *.json *.ts *.html *.md docs .github",
    "test:native": "electron tests/native-secret-electron.cjs"
  },
  "dependencies": {
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-en": "4.1.1",
    "hash-wasm": "4.12.0",
    "kdbxweb": "2.1.1",
    "koffi": "3.3.3",
    "lucide-react": "^0.468.0",
    "papaparse": "5.5.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "playwright": "^1.58.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.0",
    "vite": "6.4.5"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12",
    "roarr": "7.21.1"
  },
  "build": {
    "appId": "app.keylocal.desktop",
    "productName": "Keylocal",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": true,
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "icon": "assets/icon.icns"
    },
    "publish": null,
    "asarUnpack": [
      "node_modules/keychain-store/dist/*.node",
      "node_modules/@koromix/**/*.node",
      "node_modules/koffi/**/*.node"
    ]
  },
  "optionalDependencies": {
    "keychain-store": "1.0.0"
  }
}
